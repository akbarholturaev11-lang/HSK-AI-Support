{
  "name": "hsk-ai-support",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone minimal HSK AI Telegram support bot on Cloudflare Workers",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
